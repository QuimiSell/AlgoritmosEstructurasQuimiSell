# Puerto HTTP del API (por defecto 4000)
PORT=4000

# Orígenes CORS permitidos (separados por coma). En local: Vite en :3000
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Persistencia: memory | json
# memory = solo RAM (se pierde al reiniciar)
# json   = archivo en DATA_DIR (listo para montar volumen Docker)
PROGRESS_STORE=json

# Carpeta de datos persistentes (exámenes, progreso)
DATA_DIR=./data

# Nivel de log: silent | info | debug
LOG_LEVEL=info
